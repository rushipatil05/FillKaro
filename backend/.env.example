# Server Port (optional on Vercel, defaults to 5000 locally)
PORT=5000

# MongoDB Connection String (MongoDB Atlas URI in production)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fillkaro?retryWrites=true&w=majority

# Gemini API Key (Optional — only needed if using backend-hosted embeddings fallback)
GEMINI_API_KEY=your_gemini_api_key_here
