# Client environment variables
# Copy this to .env.local for local dev — Vite reads it automatically.
# In Vercel: add these in Project Settings → Environment Variables

# URL of your deployed backend (no trailing slash)
# Local dev:
VITE_API_URL=http://localhost:5000/api
# Vercel (replace with your backend project URL):
# VITE_API_URL=https://your-backend.vercel.app/api
